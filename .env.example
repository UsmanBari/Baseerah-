# Baseerah — Web Push & Prayer Notifications Environment Variables
# Generate a new pair with: npx web-push generate-vapid-keys
# Add these in Netlify: Site configuration → Environment variables

VAPID_PUBLIC_KEY=your_public_vapid_key_here
VAPID_PRIVATE_KEY=your_private_vapid_key_here
VAPID_SUBJECT=mailto:owner@example.com
